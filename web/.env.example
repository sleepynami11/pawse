# Copy to .env.local and edit. Defaults run everything on the scripted demo.
# Each part can be switched on its own.

# 1. Voice conversation with Pawse (camera / photos optional): mock | live
VITE_VOICE_AGENT=mock
VITE_VOICE_AGENT_URL=

# 2. Finding nearby vet clinics before calling: mock | live
VITE_CLINIC_SEARCH=mock
VITE_CLINIC_SEARCH_URL=

# 3. Pawse calling the vet / the insurer: mock | live
VITE_PHONE_AGENT=mock
VITE_PHONE_AGENT_URL=
