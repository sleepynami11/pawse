{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Deny reading real env files. Deny rules are prefix matches, so they are a speed bump, not a sandbox: keys still must never be pasted into chat.",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/*.env)",
      "Bash(cat .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(less .env:*)",
      "Bash(grep .env:*)",
      "Bash(source .env:*)"
    ]
  }
}
